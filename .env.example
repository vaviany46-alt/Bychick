# Salin file ini ke .env dan isi nilainya. JANGAN commit .env berisi nilai asli.

# Rahasia penandatanganan JWT sesi (minimal 16 karakter, wajib diganti di produksi)
JWT_SECRET=ganti-dengan-string-acak-minimal-16-karakter

# Lokasi file database SQLite (buat otomatis jika belum ada)
SQLITE_PATH=./data/bychick.db

# Password akun seed saat pertama kali dijalankan (hapus/kosongkan di produksi)
SEED_ADMIN_PASSWORD=Admin123!
SEED_KASIR_PASSWORD=Kasir123!

# Set 0 untuk menonaktifkan data demo (14 hari transaksi contoh) saat database baru
DEMO_SEED=1
